VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=server-only-never-use-VITE-prefix

# Maps
VITE_GOOGLE_MAPS_API_KEY=your-maps-key

# Transactional email (Resend)
RESEND_API_KEY=your-resend-key

# Vercel cron auth — must be set, the cron endpoint fails closed without it
CRON_SECRET=a-long-random-string

# Google Sheets live applicant sync (service account).
# Enable "Google Sheets API" + "Google Drive API" in Google Cloud, create a
# service account, then a JSON key.
# Optional: without this, applications still work and the Excel export still
# works — only the live Google Sheet is disabled.
#
# EASIEST: paste the ENTIRE downloaded JSON file as one value. No newline
# escaping to get wrong.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com", ...}
#
# ALTERNATIVE: the two fields separately. The private key must include the
# BEGIN/END header and footer lines — copy the whole value, not just the
# base64 in the middle. Literal \n escapes are handled automatically.
# GOOGLE_SA_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Wallet (falls back to the admin-editable app_settings value)
MIN_WITHDRAWAL_AMOUNT=200
